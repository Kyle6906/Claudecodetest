rules_version = '2';

// Only Kyle's account can read or write uploaded documents.
// Deploy with:  firebase deploy --only storage
service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      allow read, write: if request.auth != null
        && request.auth.token.email == 'kwaite@atlantaforklifts.com';
    }
  }
}
